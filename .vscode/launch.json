{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "XML validator (GCC)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/main.exe",
      "args": [
        "${input:xmlFile}"
      ],
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/.tools/w64devkit/bin/gdb.exe",
      "stopAtEntry": false,
      "preLaunchTask": "Build XML validator"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "d:/nccity dsa assignment-2",
      "program": "d:/nccity dsa assignment-2/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/.tools/w64devkit/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "xmlFile",
      "type": "promptString",
      "description": "XML file path (relative to the project or absolute; no surrounding quotes)",
      "default": "note.xml"
    }
  ]
}